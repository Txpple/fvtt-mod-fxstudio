{
  "id": "fvtt-mod-fxstudio",
  "title": "FX Studio",
  "description": "House visual and sound effects for dnd5e, played from what actually happened at the table. Keeps Sequencer as the engine and JB2A and PSFX as the libraries; carries the whole D&D5e Animations corpus over losslessly as its stock, adds the user's own FX on top, and never guesses an FX. No patching, no sockets, no libWrapper.",
  "version": "0.1.0",
  "authors": [
    {
      "name": "Matthew Sippel"
    }
  ],
  "esmodules": [
    "scripts/fxstudio.js"
  ],
  "styles": [
    "styles/fxstudio.css"
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.3.0",
          "verified": "5.3.3"
        }
      }
    ],
    "requires": [
      {
        "id": "sequencer",
        "type": "module",
        "compatibility": {
          "minimum": "4.0.0",
          "verified": "4.2.3"
        }
      }
    ]
  },
  "url": "https://github.com/Txpple/fvtt-mod-fxstudio",
